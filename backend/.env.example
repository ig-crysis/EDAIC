# --- App ---
ENV=development
DEBUG=true

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- MongoDB ---
# Local MongoDB:      mongodb://localhost:27017
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=edaic_db

# Set to true to run entirely in-memory (mongomock) with NO real MongoDB
# server needed — great for a quick demo to your guide.
USE_MOCK_DB=true

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- ML pipeline ---
# Expected proportion of outliers in a numeric column (0.0 - 0.5)
OUTLIER_CONTAMINATION=0.05
RANDOM_STATE=42
